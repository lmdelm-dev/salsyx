{
  "name": "salsyx-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "pages:build": "next-on-pages && node scripts/generate-sitemap.mjs .vercel/output/static",
    "pages:deploy": "wrangler pages deploy .vercel/output/static --project-name=salsyx"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "animejs": "^4.0.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.0.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.178.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.100.0"
  }
